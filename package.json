{
  "name": "dbiz-ecom",
  "version": "0.1.0",
  "private": true,
  "description": "VLX — Maritime Trading & Maritime Finance Exchange (VMFB). Next.js + Postgres.",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:schema": "tsx db/tools/emit-schema.ts",
    "db:seed": "tsx db/tools/emit-seed.ts",
    "db:all": "pnpm db:generate && pnpm db:schema && pnpm db:seed",
    "db:verify": "tsx db/tools/verify.ts",
    "db:check": "tsx --env-file=.env db/tools/check-connection.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.38.3",
    "next": "^15.1.4",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
